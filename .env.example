# =========================================================================
# POD Bot — Environment variables
# Sao chép file này sang `.env` rồi điền giá trị thực.
# =========================================================================

# ---- Database ----
POSTGRES_USER=podbot
POSTGRES_PASSWORD=podbot
POSTGRES_DB=podbot
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Backend / Frontend ports ----
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Security ----
# Sinh secret: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-48-byte-string
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ---- Default admin (tạo tự động lần đầu) ----
ADMIN_EMAIL=admin@podbot.io
ADMIN_PASSWORD=admin123

# ---- Media root (dùng /app/media khi chạy docker; ./media khi chạy host) ----
MEDIA_ROOT=/app/media

# =========================================================================
# AI engines — chỉ cần điền cái bạn muốn dùng
# =========================================================================
# Google Gemini (khuyến nghị — rẻ, nhanh, hỗ trợ sinh ảnh)
GEMINI_API_KEY=

# OpenAI (DALL-E 3 / GPT-image-1)
OPENAI_API_KEY=

# Replicate (SDXL, Flux, v.v.)
REPLICATE_API_TOKEN=

# =========================================================================
# POD platforms — điền key của platform bạn dùng
# =========================================================================
# Printify — lấy tại https://printify.com/app/account/api
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# Printful — lấy tại https://developers.printful.com/
PRINTFUL_API_KEY=

# Etsy — đăng ký app tại https://www.etsy.com/developers/
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=http://localhost:8000/api/v1/platforms/etsy/callback

# =========================================================================
# Keyword sources (đa số miễn phí, scrape)
# =========================================================================
# Pinterest Trends (cần cookie nếu muốn chính xác)
PINTEREST_COOKIE=

# TikTok Creative Center (cookie tuỳ chọn để tránh rate-limit)
TIKTOK_COOKIE=
